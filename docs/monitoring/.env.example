# Unified monitoring — host ports (defaults avoid 3000/9090/3100 collisions)
# Copy to .env and adjust if a port is taken on your machine.

UNIFIED_GRAFANA_HOST_PORT=12000
UNIFIED_PROMETHEUS_HOST_PORT=12001
UNIFIED_LOKI_HOST_PORT=12002
UNIFIED_PROMTAIL_HOST_PORT=12003
UNIFIED_NODE_EXPORTER_HOST_PORT=12004
UNIFIED_CADVISOR_HOST_PORT=12005
UNIFIED_BLACKBOX_HOST_PORT=12006

# Host log mounts for Promtail (use forward slashes)
FLEET_USER_LOCAL_SHARE=C:/Users/YOU/.local/share
