{
  "title": "plex-mcp",
  "uid": "plex-mcp-fleet",
  "tags": ["plex-mcp", "fleet", "host"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "type": "stat",
      "title": "HTTP /health (blackbox)",
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "probe_success{job=\"plex-mcp\"}", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ]
        }
      }
    },
    {
      "type": "stat",
      "title": "Probe duration (s)",
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "probe_duration_seconds{job=\"plex-mcp\"}", "refId": "A" }]
    },
    {
      "type": "timeseries",
      "title": "Health over time",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "probe_success{job=\"plex-mcp\"}",
          "legendFormat": "up",
          "refId": "A"
        }
      ]
    },
    {
      "type": "logs",
      "title": "Host logs (logs/host/plex-mcp)",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "{job=\"plex-mcp\", platform=\"host\"}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "logs",
      "title": "Errors (host + container)",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 14 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "{job=\"plex-mcp\"} |= \"ERROR\"",
          "refId": "A"
        },
        {
          "expr": "{container=~\".*plex.*\"} |= \"ERROR\"",
          "refId": "B"
        }
      ]
    }
  ]
}
