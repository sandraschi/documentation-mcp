{
  "title": "calibre-mcp",
  "uid": "calibre-mcp-fleet",
  "tags": ["calibre-mcp", "fleet", "host"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "type": "stat",
      "title": "Prometheus scrape",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "up{job=\"calibre-mcp\"}", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN" }, "1": { "text": "UP", "color": "green" } } }
          ]
        }
      }
    },
    {
      "type": "stat",
      "title": "/health (blackbox)",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "probe_success{job=\"calibre-mcp\"}", "refId": "A" }]
    },
    {
      "type": "stat",
      "title": "calibre-plus (MyAI)",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "up{job=\"calibre-plus\"}", "refId": "A" }]
    },
    {
      "type": "timeseries",
      "title": "Default process metrics (if exported)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "rate(process_cpu_seconds_total{job=\"calibre-mcp\"}[5m])",
          "legendFormat": "cpu",
          "refId": "A"
        }
      ]
    },
    {
      "type": "logs",
      "title": "Host logs",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "{job=\"calibre-mcp\", platform=\"host\"}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "logs",
      "title": "calibre-plus container",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 14 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "{container=~\".*calibre.*\"}",
          "refId": "A"
        }
      ]
    }
  ]
}
