{
  "title": "devices-mcp",
  "uid": "devices-mcp-fleet",
  "tags": ["devices-mcp", "fleet", "host"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "type": "stat",
      "title": "HTTP health (blackbox)",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "probe_success{job=\"devices-mcp\"}", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ]
        }
      }
    },
    {
      "type": "stat",
      "title": "Ring metrics scrape",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "up{job=\"devices-mcp-ring-metrics\"}", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "no scrape" }, "1": { "text": "up" } } }
          ]
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Probe latency",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "probe_duration_seconds{job=\"devices-mcp\"}",
          "legendFormat": "probe",
          "refId": "A"
        }
      ]
    },
    {
      "type": "logs",
      "title": "Host logs",
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "{job=\"devices-mcp\", platform=\"host\"}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "logs",
      "title": "Docker / container logs",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 14 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "expr": "{container=~\".*devices.*\"}",
          "refId": "A"
        }
      ]
    }
  ]
}
