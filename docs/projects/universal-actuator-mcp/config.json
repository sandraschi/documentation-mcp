                "read_file": "file_ops",
                "write_file": "file_ops",
                "edit_file": "file_ops",
                "file_exists": "file_ops",
                "get_file_info": "file_ops",
                "list_directory": "dir_ops",
                "create_directory": "dir_ops",
                "remove_directory": "dir_ops",
                "grep_file": "search_ops",
                "search_files": "search_ops"
            }
        },
