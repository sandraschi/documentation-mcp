            "command": "python",
            "args": [
                "-m",
                "filesystem_mcp"
            ],
            "env": {
                "PYTHONPATH": "D:/Dev/repos/filesystem-mcp/src"
            },
            "githubUrl": "https://github.com/sandraschi/filesystem-mcp",
