# Documentation MCP — environment configuration
# Copy to .env and fill in your values

# Backend port (default matches fleet port registry)
DOCS_MCP_PORT=11033
DOCS_HOST=127.0.0.1
DOCS_LOG_LEVEL=info

# Optional: comma-separated absolute paths for additional markdown docs
# DOCS_EXTRA_PATHS=C:\other\docs,D:\more\docs

# Optional: override docs root (defaults to repo docs/)
# DOCS_ROOT=D:\Dev\repos\mcp-central-docs\docs

# Optional: federate with advanced-memory-mcp
# DOCS_FEDERATE_MEMORY=1

# MCP bridge federation (comma-separated HTTP URLs)
# MCP_BRIDGE_URLS=http://localhost:10702/mcp

# Local LLM (Ollama)
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5

# Local LLM (LM Studio / OpenAI-compatible)
# LMSTUDIO_URL=http://localhost:1234/v1
# LMSTUDIO_MODEL=

# OpenAI-compatible API key (for cloud LLM fallback)
# LOCAL_LLM_KEY=sk-...
